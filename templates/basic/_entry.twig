{% extends '_layouts/_page.twig' %}

{% set summary = entry.pageContent.type('bodyTextBlock').one() %}

{% block title %}{{ entry.title }} | AdSpot{% endblock %}
{% block description %}{{ summary and summary.bodyText ? summary.bodyText|striptags|truncate(160) : 'Billboard advertising across New York State.' }}{% endblock %}

{% block content %}
    {% include '_partials/_entry-content.twig' with { entry: entry, heroImage: entry.indexImage.kind('image').one() } only %}
{% endblock %}
