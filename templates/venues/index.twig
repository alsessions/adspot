{% extends '_layouts/_page.twig' %}

{% block title %}Venues | AdSpot{% endblock %}
{% block description %}Explore billboard venues available through AdSpot across New York State.{% endblock %}

{% block content %}
    {% set indexImage = entry.indexImage.kind('image').one() %}
    {% set venues = craft.entries()
        .section('venues')
        .type('venue')
        .orderBy('title asc')
        .all() %}

    {% if indexImage %}
        <figure class="relative w-full overflow-hidden">
            <img src="{{ indexImage.getUrl('pageImage') }}" alt="{{ indexImage.alt ?: entry.title }}" width="{{ indexImage.getWidth('pageImage') }}" height="{{ indexImage.getHeight('pageImage') }}" class="h-[50vh] min-h-80 w-full object-cover" fetchpriority="high">
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent">
                <div class="mx-auto max-w-7xl px-6 pb-8 lg:px-10 lg:pb-12">
                    <h1 class="text-5xl font-black tracking-[-0.05em] text-white uppercase sm:text-7xl">{{ entry.title }}</h1>
                </div>
            </div>
        </figure>
    {% endif %}

    <section class="mx-auto min-h-screen max-w-7xl px-6 py-16 lg:px-10 lg:py-24">
        <p class="text-sm font-bold tracking-[0.2em] uppercase">Our locations</p>
        {% if not indexImage %}
            <h1 class="mt-4 text-5xl font-black tracking-[-0.05em] uppercase sm:text-7xl">{{ entry.title }}</h1>
        {% endif %}

        {% if venues %}
            <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for venue in venues %}
                    {% set cardImage = venue.pageImage.kind('image').one() %}
                    {% set cardImageUrl = cardImage ? cardImage.getUrl('pageImage') %}
                    <a href="{{ venue.url }}" class="group flex min-h-48 flex-col justify-between border-2 border-zinc-950 bg-cover bg-center rounded-xl p-6 transition hover:-translate-y-0.5 hover:shadow-[4px_4px_0_0_#18181b] {{ cardImage ? 'text-white' : 'bg-yellow-200' }}"{% if cardImage %} style="background-image: linear-gradient(rgb(0 0 0 / 65%), rgb(0 0 0 / 65%)), url('{{ cardImageUrl }}')"{% endif %}>
                        <h2 class="text-3xl font-black tracking-[-0.04em] uppercase">{{ venue.title }}</h2>
                        {% if venue.bodyText %}
                            <p class="mt-4 line-clamp-3 leading-relaxed">{{ venue.bodyText|striptags|truncate(140) }}</p>
                        {% endif %}
                        <span class="mt-8 font-bold">View venue <span aria-hidden="true">→</span></span>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <p class="mt-10 text-lg">No venues have been added yet.</p>
        {% endif %}
    </section>

{% endblock %}
