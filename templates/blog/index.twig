{% extends '_layouts/_page.twig' %}

{% block title %}Blog | AdSpot{% endblock %}
{% block description %}News, ideas, and updates from AdSpot.{% endblock %}

{% block content %}
    {% set indexImage = entry.indexImage.kind('image').one() %}
    {% set posts = craft.entries()
        .section('blog')
        .orderBy('postDate desc')
        .all() %}

    {% include '_partials/_index-hero.twig' with { entry: entry, indexImage: indexImage } only %}

    <section class="mx-auto min-h-screen max-w-[1400px] px-6 py-16 lg:px-10 lg:py-24">
        <p class="text-sm font-bold tracking-[0.2em] uppercase">Latest news</p>
        {% include '_partials/_page-content.twig' with { entry: entry, heroImage: true } only %}

        {% if posts %}
            <div class="mt-12">
                {% for post in posts %}
                    {% set cardImage = post.indexImage.kind('image').one() %}
                    {% set summary = post.pageContent.type('bodyTextBlock').one() %}
                    {% if not loop.first %}
                        <hr class="my-10 border-t-2 border-zinc-950 md:my-14">
                    {% endif %}
                    <a href="{{ post.url }}" class="group grid gap-6 {{ cardImage ? 'sm:grid-cols-[1fr_2fr]' : '' }} md:gap-10">
                        {% if cardImage %}
                            <img src="{{ cardImage.getUrl('pageImage') }}" alt="{{ cardImage.alt ?: post.title }}" width="{{ cardImage.getWidth('pageImage') }}" height="{{ cardImage.getHeight('pageImage') }}" class="h-full min-h-56 w-full rounded-xl object-cover">
                        {% endif %}
                        <div class="flex min-h-56 flex-col justify-between">
                            <div>
                                <time datetime="{{ post.postDate|date('Y-m-d') }}" class="text-sm font-semibold md:text-base">{{ post.postDate|date('F j, Y') }}</time>
                                <h2 class="mt-2 text-3xl font-black tracking-[-0.04em] uppercase group-hover:underline md:text-4xl">{{ post.title }}</h2>
                                {% if summary and summary.bodyText %}
                                    <p class="mt-4 line-clamp-5 leading-relaxed md:text-lg">{{ summary.bodyText|striptags|truncate(400) }}</p>
                                {% endif %}
                            </div>
                            <span class="mt-8 font-bold md:text-lg">Read article <span aria-hidden="true">→</span></span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <p class="mt-10 text-lg">No blog posts have been added yet.</p>
        {% endif %}
    </section>
{% endblock %}
