{% set cardImage = market.pageImage.kind('image').one() %}
{% set cardImageUrl = cardImage ? cardImage.getUrl('pageImage') %}

<a href="{{ market.url }}" class="group flex min-h-48 flex-col justify-between rounded-xl border-2 border-zinc-950 bg-cover bg-center p-6 transition hover:-translate-y-0.5 hover:shadow-[4px_4px_0_0_#18181b] {{ cardImage ? 'text-white' : 'bg-yellow-200' }}"{% if cardImage %} style="background-image: linear-gradient(rgb(0 0 0 / 65%), rgb(0 0 0 / 65%)), url('{{ cardImageUrl }}')"{% endif %}>
    <h2 class="text-3xl font-black tracking-[-0.04em] uppercase">{{ market.title }}</h2>
    {% if market.bodyText %}
        <p class="mt-4 line-clamp-3 leading-relaxed">{{ market.bodyText|striptags|truncate(140) }}</p>
    {% endif %}
    <span class="mt-8 font-bold">View market <span aria-hidden="true">→</span></span>
</a>
