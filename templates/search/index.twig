{% extends '_layouts/_page.twig' %}

{% set searchQuery = craft.app.request.getQueryParam('q')|trim %}
{% set results = searchQuery
    ? craft.entries()
        .section('markets')
        .type('market')
        .search(searchQuery)
        .orderBy('score')
        .all()
    : [] %}

{% block title %}Search{% if searchQuery %}: {{ searchQuery }}{% endif %} | AdSpot{% endblock %}
{% block description %}Search AdSpot markets by city, state, ZIP, or address.{% endblock %}

{% block content %}
    {% include 'search/_form.twig' with { searchQuery: searchQuery } %}

    <section class="mx-auto min-h-[50vh] max-w-[1400px] px-6 py-16 lg:px-10 lg:py-24">
        {% if searchQuery %}
            <p class="text-sm font-bold tracking-[0.2em] uppercase">Search results</p>
            <h1 class="mt-4 text-4xl font-black tracking-[-0.05em] uppercase sm:text-6xl">{{ results|length }} result{{ results|length == 1 ? '' : 's' }} for “{{ searchQuery }}”</h1>

            {% if results %}
                <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {% for market in results %}
                        {% include 'search/_result.twig' with { market: market } only %}
                    {% endfor %}
                </div>
            {% else %}
                <p class="mt-8 text-lg">No matching markets were found. Try a broader location.</p>
            {% endif %}
        {% else %}
            <h1 class="text-4xl font-black tracking-[-0.05em] uppercase sm:text-6xl">Search markets</h1>
            <p class="mt-6 text-lg">Enter a location above to find a market.</p>
        {% endif %}
    </section>
{% endblock %}
