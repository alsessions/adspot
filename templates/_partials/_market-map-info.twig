{% set cardImage = entry.pageImage.kind('image').one() %}

<article class="w-64 overflow-hidden  bg-zinc-950 text-white">
    {% if cardImage %}
        <img src="{{ cardImage.getUrl('pageImage') }}" alt="" class="aspect-video w-full object-cover">
    {% endif %}
    <div class="p-4">
        <h3 class="text-xl font-black tracking-[-0.04em] uppercase">{{ entry.title }}</h3>
        <div class="mt-3 flex flex-col items-start">
            {% if entry.type|length %}
                <div class="flex flex-wrap gap-2">
                    {% for category in entry.type %}
                        <span class="inline-flex rounded-full bg-gradient-to-r from-[#fce604] to-lime-300 px-3 py-1 text-xs font-black text-zinc-950 uppercase">{{ category.label }}&nbsp;-&nbsp;{{ marketTypeCounts[category.value] }}</span>
                    {% endfor %}
                </div>
            {% endif %}
            <a href="{{ siteUrl('contact') }}" class="{{ entry.type|length ? 'mt-12 ' }}inline-flex rounded-full bg-gradient-to-r from-sky-400 via-blue-500 to-fuchsia-500 px-4 py-1.5 text-sm font-black text-white uppercase shadow-[0_4px_14px_rgb(59_130_246/0.35)] transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Get A Quote <span class="ml-1" aria-hidden="true">→</span></a>
        </div>
    </div>
</article>
