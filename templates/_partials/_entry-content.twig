{% set heroImage = entry.pageImage.kind('image').one() %}

{% if heroImage %}
    <figure class="relative w-full overflow-hidden">
        <img src="{{ heroImage.getUrl('pageImage') }}" alt="{{ heroImage.alt ?: entry.title }}" width="{{ heroImage.getWidth('pageImage') }}" height="{{ heroImage.getHeight('pageImage') }}" class="h-[50vh] min-h-80 w-full object-cover" fetchpriority="high">
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent">
            <div class="mx-auto max-w-[1400px] px-6 pb-8 lg:px-10 lg:pb-12">
                <h1 class="max-w-5xl text-5xl font-black tracking-[-0.05em] text-white uppercase sm:text-7xl">{{ entry.title }}</h1>
            </div>
        </div>
    </figure>
{% endif %}

<section class="mx-auto max-w-[1400px] px-6 py-16 lg:px-10 lg:py-24">
    {% if not heroImage %}
        <h1 class="text-5xl font-black tracking-[-0.05em] uppercase sm:text-7xl">{{ entry.title }}</h1>
    {% endif %}

    {% if entry.bodyText %}
        <div class="{{ heroImage ? '' : 'mt-8' }} {{ prose|default(false) ? 'prose prose-lg prose-zinc' : 'max-w-3xl whitespace-pre-line text-lg leading-relaxed' }}">{{ entry.bodyText }}</div>
    {% endif %}
</section>
