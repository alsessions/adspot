{% set cardImage = entry.pageImage.kind('image').one() %}

<article class="w-64 overflow-hidden rounded-xl bg-white text-zinc-950">
    {% if cardImage %}
        <img src="{{ cardImage.getUrl('pageImage') }}" alt="" class="aspect-video w-full object-cover">
    {% endif %}
    <div class="p-4">
        <h3 class="text-xl font-black tracking-[-0.04em] uppercase">{{ entry.title }}</h3>
        <a href="{{ entry.url }}" class="mt-4 inline-block font-bold">View venue <span aria-hidden="true">→</span></a>
    </div>
</article>
