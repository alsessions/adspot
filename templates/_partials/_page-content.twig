{% set contentBlocks = entry.pageContent.all() %}

{% for block in contentBlocks %}
    {% set spacing = loop.first ? (heroImage|default(null) ? '' : 'mt-8') : 'mt-12' %}

    {% switch block.type.handle %}
        {% case 'bodyTextBlock' %}
            {% if block.bodyText %}
                <div class="{{ spacing }} prose prose-xl prose-zinc flow-root max-w-none md:prose-2xl">{{ block.bodyText }}</div>
            {% endif %}

        {% case 'bodyImage' %}
            {% set image = block.pageImages.kind('image').one() %}
            {% if image %}
                <figure class="{{ spacing }} max-w-5xl overflow-hidden rounded-xl">
                    <img src="{{ image.getUrl('pageImage') }}" alt="{{ image.alt ?: entry.title }}" width="{{ image.getWidth('pageImage') }}" height="{{ image.getHeight('pageImage') }}" class="h-auto w-full object-cover" loading="lazy">
                </figure>
            {% endif %}

        {% case 'imageTextBlock' %}
            {% set image = block.pageImages.kind('image').one() %}
            {% if image and block.bodyText %}
                <section class="{{ spacing }} grid grid-cols-[minmax(0,1fr)_minmax(0,3fr)] items-start gap-6 sm:gap-10">
                    <img src="{{ image.getUrl('inlineMedium') }}" alt="{{ image.alt ?: entry.title }}" width="{{ image.getWidth('inlineMedium') }}" height="{{ image.getHeight('inlineMedium') }}" class="h-auto w-full" loading="lazy">
                    <div class="prose prose-xl prose-zinc max-w-none md:prose-2xl">{{ block.bodyText }}</div>
                </section>
            {% endif %}

        {% case 'simpleGridBlock' %}
            {% include '_partials/_simple-grid.twig' with { entry: block, spacing: spacing } only %}

        {% case 'fullWidthCta' %}
            <section class="{{ spacing }} relative left-1/2 w-screen -translate-x-1/2 bg-[#1e2939] text-white">
                <div class="mx-auto max-w-[1400px] px-6 py-16 lg:px-10 lg:py-24">
                    <div>
                        {% if block.eyebrow %}
                            <p class="text-center text-sm font-black tracking-[0.2em] text-[#fce604] uppercase">{{ block.eyebrow }}</p>
                        {% endif %}
                        <h2 class="{{ block.eyebrow ? 'mt-4 ' }}text-center text-4xl font-black tracking-[-0.05em] uppercase sm:text-6xl">{{ block.heading }}</h2>
                        {% if block.bodyText %}
                            <div class="prose prose-xl prose-invert mx-auto mt-6 max-w-5xl font-semibold sm:prose-2xl">{{ block.bodyText }}</div>
                        {% endif %}
                    </div>
                </div>
            </section>
    {% endswitch %}
{% endfor %}
