{% extends '_layouts/_page.twig' %}

{% block title %}Advertisers | AdSpot{% endblock %}
{% block description %}Advertising opportunities available through AdSpot across New York State.{% endblock %}

{% block content %}
    {% set indexImage = entry.indexImage.kind('image').one() %}
    {% set gridItems = grid.advertiserGrid.all() %}

    {% if indexImage %}
        <figure class="relative w-full overflow-hidden">
            <img src="{{ indexImage.getUrl('pageImage') }}" alt="{{ indexImage.alt ?: entry.title }}" width="{{ indexImage.getWidth('pageImage') }}" height="{{ indexImage.getHeight('pageImage') }}" class="h-[50vh] min-h-80 w-full object-cover" fetchpriority="high">
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent">
                <div class="mx-auto max-w-[1400px] px-6 pb-8 lg:px-10 lg:pb-12">
                    <h1 class="text-5xl font-black tracking-[-0.05em] text-white uppercase sm:text-7xl">{{ entry.title }}</h1>
                </div>
            </div>
        </figure>
    {% endif %}

    <section class="mx-auto min-h-screen max-w-[1400px] px-6 py-16 lg:px-10 lg:py-24">
        <p class="text-sm font-bold tracking-[0.2em] uppercase">Our network</p>
        {% if not indexImage %}
            <h1 class="mt-4 text-5xl font-black tracking-[-0.05em] uppercase sm:text-7xl">{{ entry.title }}</h1>
        {% endif %}

        {% if gridItems %}
            <div class="mt-12 grid gap-5 md:grid-cols-2">
                {% for item in gridItems %}
                    <article class="flex min-h-56 flex-col rounded-xl border border-white/10 bg-zinc-900 p-7 text-white">
                        <div class="flex items-center gap-4">
                            <span class="rounded-full bg-yellow-300 px-3 py-1 text-xs font-bold tracking-wide text-zinc-950 uppercase">{{ item.gridIcon.label }}</span>
                            <h2 class="text-xl font-bold tracking-[-0.03em]">{{ item.heading }}</h2>
                        </div>

                        {% if item.body %}
                            <div class="prose prose-invert mt-6 max-w-none text-zinc-300 prose-a:text-yellow-300 prose-a:hover:text-white">{{ item.body }}</div>
                        {% endif %}

                        {% if item.gridLink %}
                            <a href="{{ item.gridLink.url }}" class="mt-auto pt-10 font-bold text-yellow-300 transition hover:text-white">
                                {{ item.gridLink.label ?: 'Learn more' }} <span aria-hidden="true">→</span>
                            </a>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
