<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="AdSpot connects New York businesses with high-impact billboard advertising across the state.">
    <title>AdSpot | Billboard Advertising Across New York</title>
    <link rel="stylesheet" href="{{ siteUrl('css/app.css') }}">
</head>
<body class="min-h-screen bg-yellow-300 text-zinc-950 antialiased">
    {% include '_partials/_nav.twig' %}

    <main>
        <section class="mx-auto grid min-h-screen max-w-7xl items-center gap-12 px-6 py-16 lg:grid-cols-[1fr_0.65fr] lg:px-10 lg:py-20">
            <div>
                <p class="mb-6 text-sm font-bold tracking-[0.2em] uppercase">Billboard advertising · New York State</p>
                <h1 class="max-w-5xl text-6xl leading-[0.88] font-black tracking-[-0.07em] uppercase sm:text-7xl lg:text-[7.5rem]">
                    Put your brand in the right spot.
                </h1>
                <p class="mt-8 max-w-2xl text-xl leading-relaxed font-medium sm:text-2xl">
                    AdSpot helps businesses reach more people with high-impact billboard placements across New York.
                </p>
            </div>

            <aside id="contact" class="border-4 border-zinc-950 bg-yellow-200 p-7 shadow-[10px_10px_0_0_#18181b] sm:p-9">
                <p class="text-xs font-bold tracking-[0.2em] uppercase">Your next campaign</p>
                <h2 class="mt-4 text-4xl leading-none font-black tracking-[-0.05em] uppercase">Ready to get noticed?</h2>
                <p class="mt-5 text-lg leading-relaxed">Tell us who you want to reach. We’ll help you find the right location.</p>
                <a href="mailto:hello@adspot.com" class="mt-8 inline-flex w-full items-center justify-between bg-zinc-950 px-5 py-4 font-bold text-yellow-300 transition hover:bg-zinc-800">
                    hello@adspot.com
                    <span aria-hidden="true">→</span>
                </a>
            </aside>
        </section>
    </main>
    {% include '_partials/_footer.twig' %}
</body>
</html>
