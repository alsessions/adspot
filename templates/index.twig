<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="AdSpot connects New York businesses with high-impact billboard advertising across the state.">
    <title>AdSpot | Billboard Advertising Across New York</title>
    <link rel="stylesheet" href="{{ siteUrl('css/app.css') }}">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="min-h-screen bg-[#fce604] text-gray-800 antialiased">
    {% include '_partials/_nav.twig' %}

    <main>
        {% set heroImage = entry.pageImage.kind('image').one() %}
        <section class="relative isolate min-h-[clamp(34rem,calc(100svh-114px),48rem)] overflow-hidden bg-gray-800 text-white">
            {% if heroImage %}
                <img src="{{ heroImage.url }}" alt="{{ heroImage.alt }}" width="{{ heroImage.width }}" height="{{ heroImage.height }}" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high">
            {% endif %}
            <div class="absolute inset-0 -z-10 bg-linear-to-r from-gray-800/85 via-gray-800/60 to-gray-800/25"></div>

            <div class="mx-auto flex min-h-[clamp(34rem,calc(100svh-114px),48rem)] max-w-[1400px] flex-col justify-end px-6 pt-16 pb-10 lg:px-10 lg:pt-20">
                <div class="max-w-5xl">
                    <h1 class="text-5xl leading-[0.95] font-light tracking-[-0.05em] text-[#fce604] sm:text-7xl lg:text-8xl">
                        {{ entry.heading }} <strong class="font-black">{{ entry.headingAccent }}</strong>
                    </h1>
                    <p class="mt-8 max-w-5xl whitespace-pre-line text-base leading-relaxed text-white/90 sm:text-lg">{{ entry.bodyCopy }}</p>
                    {% if entry.primaryCtaUrl %}
                        <a href="{{ entry.primaryCtaUrl }}" class="mt-8 inline-flex items-center gap-3 rounded-sm bg-yellow-300 px-7 py-4 font-bold text-gray-800 transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
                            {{ entry.primaryCtaLabel }} <span aria-hidden="true">→</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </section>

        <section class="border-t-2 border-gray-800 bg-[#fce604]">
            <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-10 lg:py-28">
                <p class="text-sm font-bold tracking-[0.2em] uppercase">From idea to impact</p>
                <h2 class="mt-4 text-5xl font-black tracking-[-0.05em] uppercase sm:text-7xl">How it works</h2>

                <div class="mt-12 grid gap-5 lg:grid-cols-3">
                    {% for step in entry.homeContent.all() %}
                        <article class="flex min-h-80 flex-col border-2 border-gray-800 bg-gray-800 p-7 text-white sm:p-9 rounded-md">
                            <p class="text-sm font-black tracking-[0.2em] text-[#fce604] uppercase">{{ step.eyebrow }}</p>
                            <h3 class="mt-6 text-3xl font-black tracking-[-0.04em] uppercase">{{ step.heading }}</h3>
                            <p class="mt-5 text-lg leading-relaxed">{{ step.bodyCopy|nl2br }}</p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>

        {% set homeLogos = entry.homeLogos.all() %}
        <section class="border-t-2 border-gray-800 bg-gray-800 text-white">
            <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-10 lg:py-28">
                <p class="text-center text-sm font-bold tracking-[0.2em] text-[#fce604] uppercase">Our community</p>
                <h2 class="mx-auto mt-4 max-w-4xl text-center text-5xl font-black tracking-[-0.05em] uppercase sm:text-7xl">Trusted by local favorites</h2>
                {% if homeLogos %}
                    <div class="mt-12 flex flex-nowrap items-center gap-10 overflow-x-auto py-4 lg:justify-center">
                        {% for logo in homeLogos %}
                            {% set logoImage = logo.logoImage.one() %}
                            {% if logoImage %}
                                <img src="{{ logoImage.url }}" alt="{{ logoImage.alt ?: logoImage.title }}" width="{{ logoImage.width }}" height="{{ logoImage.height }}" class="max-h-20 w-auto max-w-48 shrink-0 object-contain" loading="lazy">
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="mx-auto mt-12 h-2 w-24 bg-[#fce604]"></div>
                {% endif %}
            </div>
        </section>

        <section class="border-t-2 border-gray-800 bg-[#fce604] text-gray-800">
            <div class="mx-auto grid max-w-[1400px] items-center gap-14 px-6 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:px-10 lg:py-28">
                <div>
                    <h2 class="text-5xl font-black tracking-[-0.05em] uppercase sm:text-7xl">The Empire State. 15+ Venues.</h2>
                    <p class="mt-6 max-w-xl text-sm leading-relaxed text-gray-800/80">Born in New York, growing across America. From local venues to major cities, be where the crowds are, seven days a week. Excelsior.</p>
                    <a href="{{ siteUrl('markets') }}" class="mt-9 inline-flex items-center gap-3 bg-gray-800 px-7 py-4 font-bold text-[#fce604] transition hover:bg-white hover:text-gray-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gray-800">
                        View our footprint <span aria-hidden="true">→</span>
                    </a>
                </div>

                <div class="bg-gray-800 p-2 sm:p-6" aria-label="AdSpot markets in New York State">
                    <svg viewBox="0 -20 760 470" role="img" aria-labelledby="new-york-map-title new-york-map-description" class="h-auto w-full">
                        <title id="new-york-map-title">New York State market map</title>
                        <desc id="new-york-map-description">AdSpot currently serves the Syracuse and Utica areas.</desc>
                        <path d="M597.1 330.1 596.1 333.2 602.9 331.9 602.3 328.9Z M153.6 252.9 153.6 263.7 153.7 273.9 170.2 274 193.8 273.9 220.4 273.8 252.8 273.9 276.9 273.9 311.4 273.8 337.1 273.8 360.7 273.9 398.7 273.9 405.7 274.3 409.6 277.9 411.3 282.8 418 285.5 422.1 289.2 423.5 301.6 423.8 306.8 427.3 312.9 432.6 316.1 440.3 318.2 443.8 323.7 457.4 332.2 470.2 340.3 481.3 346.8 489.7 351.6 487.3 360.5 485.6 364.9 482.5 371.2 480.9 375.4 478.6 378.4 472.1 380 471.9 383 469.3 386.7 468.7 390 477.2 386.5 480.3 382.6 487 386.9 493.6 384.3 504.2 383.8 516.6 381.4 528.9 380 540.2 376.3 551.9 370.9 575.5 361.7 592.6 354.6 606.4 345.9 600.5 345.9 595.2 349.8 592.7 347.2 590.9 342.5 585.7 348.3 581.9 346.1 587.7 337.6 581.5 339.3 575.8 343 569.3 348 557.6 353.1 538.6 354.2 532.6 354.8 527.7 358.8 518.4 354.9 513.1 355.6 512.2 357.8 505.5 359.3 498.4 361 497.5 358.2 503.2 352.6 503.1 350 499.2 343.6 513.2 334.9 509.3 328.5 510.1 317.2 511.2 299.7 513 270 511.8 267.1 520.7 234.3 525.7 216 524.2 211.6 525.2 200.6 526.2 171.9 527 154.8 522.1 147.7 518.2 152.2 517.1 145.2 520.8 136.5 518.5 132.9 519.5 128.4 517.3 120.6 517.6 117.8 515.9 115.4 518.2 105.8 522.7 98.7 521.7 91 524.1 84.5 520.9 76.3 518.5 70.6 520.4 60.5 521.7 56.5 519.1 52.2 521.5 47.5 521.2 40.3 504.2 40.9 482 41.3 458.6 41.4 441 41.9 435.8 40 426.8 42.9 418.2 48.9 407.2 56.2 393.8 67.6 382.5 78.7 377 87.3 369 91.7 359.8 96.9 357.2 102.1 349.9 105.9 347.8 110.9 348.4 113.1 347.6 116.3 353.1 120.8 345.5 124.5 343.8 127.8 352.1 129.8 355.9 133.9 357.5 143.5 357.4 151.7 350.8 156.5 345.2 155.8 332.9 164.2 325 171.6 314.5 175.3 296.7 174.8 283.1 176.9 274 174.3 265 169.6 246.2 167.1 223.2 167.6 193.2 175.9 194.7 184.4 193 190.2 197 191.8 196.1 196.7 201.4 199.9 202.3 205.1 205.5 211.4 202.7 216 194.5 220.4 190.9 226.3 186.2 231.5 175.4 237.7 161.3 248.7Z" fill="#fce604" stroke="#fce604" stroke-width="5" stroke-linejoin="round" transform="translate(387 191) scale(1.3) translate(-387 -191)"/>
                        <ellipse cx="387" cy="191" rx="75" ry="46" fill="#fff" opacity=".3"/>
                        <polygon points="353,182 356.2,189.9 364.4,190.3 358.2,195.6 360.1,203.7 353,199 345.9,203.7 347.8,195.6 341.6,190.3 349.8,189.9" fill="#1f2937" stroke="#fff" stroke-width="3" stroke-linejoin="round"/>
                        <polygon points="421,175 424.2,182.9 432.4,183.3 426.2,188.6 428.1,196.7 421,192 413.9,196.7 415.8,188.6 409.6,183.3 417.8,182.9" fill="#1f2937" stroke="#fff" stroke-width="3" stroke-linejoin="round"/>
                        <text x="340" y="225" fill="#1f2937" font-size="16" font-weight="800" text-anchor="end">SYRACUSE</text>
                        <text x="435" y="165" fill="#1f2937" font-size="16" font-weight="800">UTICA</text>
                    </svg>
                </div>
            </div>
        </section>

        <section class="border-t-2 border-gray-800 bg-gray-800 text-white">
            <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-10 lg:py-28">
                <p class="text-sm font-bold tracking-[0.2em] text-[#fce604] uppercase">Growing New York. Ever Excelsior.</p>
                <h2 class="mt-4 max-w-5xl text-5xl font-black tracking-[-0.05em] uppercase sm:text-7xl lg:text-8xl">Be where America is!</h2>
                <p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/75">Simple advertising: high-traffic venues, repeated exposure, real attention.</p>
                <div class="mt-10 flex flex-wrap gap-4">
                    <a href="{{ siteUrl('advertisers') }}" class="inline-flex items-center gap-3 bg-[#fce604] px-7 py-4 font-bold text-gray-800 transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
                        Explore advertising <span aria-hidden="true">→</span>
                    </a>
                    <a href="{{ siteUrl('contact') }}" class="inline-flex items-center gap-3 border-2 border-white px-7 py-4 font-bold text-white transition hover:border-[#fce604] hover:text-[#fce604] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
                        Contact us <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </section>
    </main>
    {% include '_partials/_footer.twig' %}
</body>
</html>
