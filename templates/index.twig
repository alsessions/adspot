<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="AdSpot connects New York businesses with high-impact billboard advertising across the state.">
    <title>AdSpot | Billboard Advertising Across New York</title>
    <link rel="stylesheet" href="{{ siteUrl('css/app.css') }}">
</head>
<body class="min-h-screen bg-[#fce604] text-zinc-950 antialiased">
    {% include '_partials/_nav.twig' %}

    <main>
        {% set heroImage = entry.pageImage.kind('image').one() %}
        <section class="relative isolate min-h-[clamp(34rem,calc(100svh-114px),48rem)] overflow-hidden bg-zinc-950 text-white">
            {% if heroImage %}
                <img src="{{ heroImage.url }}" alt="{{ heroImage.alt }}" width="{{ heroImage.width }}" height="{{ heroImage.height }}" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high">
            {% endif %}
            <div class="absolute inset-0 -z-10 bg-linear-to-r from-black/85 via-black/60 to-black/25"></div>

            <div class="mx-auto flex min-h-[clamp(34rem,calc(100svh-114px),48rem)] max-w-[1400px] flex-col justify-end px-6 pt-16 pb-10 lg:px-10 lg:pt-20">
                <div class="max-w-5xl">
                    <h1 class="text-5xl leading-[0.95] font-light tracking-[-0.05em] sm:text-7xl lg:text-8xl">
                        {{ entry.heading }} <strong class="font-black text-yellow-300">{{ entry.headingAccent }}</strong>
                    </h1>
                    <p class="mt-8 max-w-5xl whitespace-pre-line text-base leading-relaxed text-white/90 sm:text-lg">{{ entry.bodyCopy }}</p>
                    {% if entry.primaryCtaUrl %}
                        <a href="{{ entry.primaryCtaUrl }}" class="mt-8 inline-flex items-center gap-3 rounded-sm bg-yellow-300 px-7 py-4 font-bold text-zinc-950 transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
                            {{ entry.primaryCtaLabel }} <span aria-hidden="true">→</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </section>

        {% for block in entry.homeContent.all() %}
            <section class="border-t-2 border-zinc-950">
                <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-10 lg:py-24">
                    <p class="text-sm font-bold tracking-[0.2em] uppercase">{{ block.eyebrow }}</p>
                    <h2 class="mt-4 max-w-3xl text-4xl font-black tracking-[-0.05em] uppercase sm:text-6xl">{{ block.heading }}</h2>
                    <p class="mt-6 max-w-2xl text-lg leading-relaxed">{{ block.bodyCopy|nl2br }}</p>
                </div>
            </section>
        {% endfor %}
    </main>
    {% include '_partials/_footer.twig' %}
</body>
</html>
