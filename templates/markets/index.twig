{% extends '_layouts/_page.twig' %}

{% block title %}Markets | AdSpot{% endblock %}
{% block description %}Explore New York advertising markets served by AdSpot.{% endblock %}

{% block content %}
    {% set indexImage = entry.indexImage.kind('image').one() %}
    {% set markets = craft.entries()
        .section('markets')
        .type('market')
        .orderBy('title asc')
        .all() %}

    {% if indexImage %}
        <figure class="relative w-full overflow-hidden">
            <img src="{{ indexImage.getUrl('pageImage') }}" alt="{{ indexImage.alt ?: entry.title }}" width="{{ indexImage.getWidth('pageImage') }}" height="{{ indexImage.getHeight('pageImage') }}" class="h-[50vh] min-h-80 w-full object-cover" fetchpriority="high">
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent">
                <div class="mx-auto max-w-[1400px] px-6 pb-8 lg:px-10 lg:pb-12">
                    <h1 class="text-5xl font-black tracking-[-0.05em] text-white uppercase sm:text-7xl">{{ entry.title }}</h1>
                </div>
            </div>
        </figure>
    {% endif %}

    <section class="mx-auto max-w-[1400px] px-6 pt-16 pb-12 lg:px-10 lg:pt-24 lg:pb-16">
        <p class="text-sm font-bold tracking-[0.2em] uppercase">Where we work</p>
        {% if not indexImage %}
            <h1 class="mt-4 text-5xl font-black tracking-[-0.05em] uppercase sm:text-7xl">{{ entry.title }}</h1>
        {% endif %}
        {% if entry.bodyText %}
            <div class="prose prose-lg prose-zinc mt-8 max-w-3xl">{{ entry.bodyText }}</div>
        {% endif %}

        {% include '_partials/_simple-grid.twig' %}
    </section>

    {% include 'search/_form.twig' %}

    <section class="mx-auto max-w-[1400px] px-6 lg:px-10" aria-labelledby="markets-map-heading">
        <h2 id="markets-map-heading" class="sr-only">Market locations</h2>
        <div class="w-full [&_.gm-map]:h-[50svh] [&_.gm-map]:min-h-96 [&_.gm-map]:w-full lg:[&_.gm-map]:h-[70svh]" role="region" aria-label="Map showing all market locations">
            {{ googleMaps.map(markets, {
                id: 'markets-map',
                field: 'address',
                cluster: true,
                infoWindowTemplate: '_partials/_market-map-info'
            }).tag() }}
        </div>
    </section>

    <section class="mx-auto max-w-[1400px] px-6 py-16 lg:px-10 lg:py-24" aria-label="Markets">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for market in markets %}
                {% set cardImage = market.pageImage.kind('image').one() %}
                {% set cardImageUrl = cardImage ? cardImage.getUrl('pageImage') %}
                <a href="{{ market.url }}" class="group flex min-h-48 flex-col justify-between border-2 border-zinc-950 bg-cover bg-center rounded-xl p-6 transition hover:-translate-y-0.5 hover:shadow-[4px_4px_0_0_#18181b] {{ cardImage ? 'text-white' : 'bg-yellow-200' }}"{% if cardImage %} style="background-image: linear-gradient(rgb(0 0 0 / 65%), rgb(0 0 0 / 65%)), url('{{ cardImageUrl }}')"{% endif %}>
                    <h2 class="text-3xl font-black tracking-[-0.04em] uppercase">{{ market.title }}</h2>
                    {% if market.bodyText %}
                        <p class="mt-4 line-clamp-3 leading-relaxed">{{ market.bodyText|striptags|truncate(140) }}</p>
                    {% endif %}
                    <span class="mt-8 font-bold">View market <span aria-hidden="true">→</span></span>
                </a>
            {% endfor %}
        </div>
    </section>
{% endblock %}
