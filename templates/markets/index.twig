{% extends '_layouts/_page.twig' %}

{% block title %}Markets | AdSpot{% endblock %}
{% block description %}Explore New York advertising markets served by AdSpot.{% endblock %}

{% block content %}
    {% set indexImage = entry.indexImage.kind('image').one() %}
    {% set markets = craft.entries()
        .section('markets')
        .type('market')
        .orderBy('title asc')
        .all() %}
    {% set marketTypeOptions = craft.app.fields.getFieldByHandle('type').options %}
    {% set marketTypeCounts = {} %}
    {% for option in marketTypeOptions %}
        {% set count = 0 %}
        {% for market in markets %}
            {% for category in market.type %}
                {% if category.value == option.value %}
                    {% set count = count + 1 %}
                {% endif %}
            {% endfor %}
        {% endfor %}
        {% set marketTypeCounts = marketTypeCounts|merge({ (option.value): count }) %}
    {% endfor %}

    {% include '_partials/_index-hero.twig' with { entry: entry, indexImage: indexImage } only %}

    <section class="mx-auto max-w-[1400px] px-6 pt-16 pb-12 lg:px-10 lg:pt-24 lg:pb-16">
        {% include '_partials/_page-content.twig' with { entry: entry, heroImage: true } only %}
    </section>

    <section class="mx-auto max-w-[1400px] px-6 lg:px-10" aria-labelledby="markets-map-heading">
        <h2 id="markets-map-heading" class="sr-only">Market locations</h2>
        <div class="space-y-4">
            {% include 'search/_form.twig' with { embedded: true } %}

            <fieldset class="rounded-xl bg-[#fce604] px-6 py-4 text-zinc-950 lg:px-8">
                <legend class="sr-only">Filter by type</legend>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-8">
                    <span class="shrink-0 text-sm font-bold tracking-wide uppercase" aria-hidden="true">Filter by category</span>
                    <div class="flex flex-wrap gap-x-7 gap-y-2">
                        {% for option in marketTypeOptions %}
                            <label class="inline-flex cursor-pointer items-center gap-2 font-bold">
                                <input type="checkbox" value="{{ option.value }}" aria-controls="markets-map" data-market-category-filter class="size-5 accent-zinc-950">
                                <span>{{ option.label }}&nbsp;({{ marketTypeCounts[option.value] }})</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </fieldset>

            <div class="w-full overflow-hidden rounded-xl [&_.gm-map]:h-[50svh] [&_.gm-map]:min-h-96 [&_.gm-map]:w-full [&_.gm-style-iw-c]:!bg-zinc-950 [&_.gm-style-iw-c]:!p-0 [&_.gm-style-iw-chr]:!h-8 [&_.gm-style-iw-chr]:!bg-zinc-950 [&_.gm-style-iw-d]:!overflow-hidden [&_.gm-style-iw-d]:!bg-zinc-950 [&_.gm-style-iw-tc::after]:!bg-zinc-950 [&_.gm-ui-hover-effect]:!top-0 [&_.gm-ui-hover-effect]:!right-0 [&_.gm-ui-hover-effect]:!size-8 [&_.gm-ui-hover-effect>span]:!m-2 [&_.gm-ui-hover-effect>span]:!size-4 [&_.gm-ui-hover-effect>span]:!bg-white lg:[&_.gm-map]:h-[70svh]" role="region" aria-label="Map showing all market locations">
                {{ googleMaps.map(markets, {
                    id: 'markets-map',
                    field: 'address',
                    cluster: true,
                    infoWindowTemplate: '_partials/_market-map-info',
                    infoWindowData: { marketTypeCounts: marketTypeCounts }
                }).tag() }}
            </div>
        </div>
    </section>

    <script>
        addEventListener('load', () => {
            setTimeout(() => {
                const map = googleMaps.getMap('markets-map')
                const marketCategories = {
                    {% for market in markets %}
                        {% set categories = [] %}
                        {% for category in market.type %}
                            {% set categories = categories|merge([category.value]) %}
                        {% endfor %}
                        '{{ market.id }}-address': {{ categories|json_encode|raw }}{{ not loop.last ? ',' }}
                    {% endfor %}
                }
                const categoryFilters = [...document.querySelectorAll('[data-market-category-filter]')]

                google.maps.event.addListener(map._map, 'click', () => map.closeInfoWindow('*'))

                categoryFilters.forEach(filter => filter.addEventListener('change', () => {
                    const selectedCategories = categoryFilters
                        .filter(filter => filter.checked)
                        .map(filter => filter.value)
                    const visibleMarkers = Object.entries(marketCategories)
                        .filter(([, categories]) => !selectedCategories.length || selectedCategories.some(category => categories.includes(category)))
                        .map(([markerId]) => markerId)

                    map.closeInfoWindow('*')
                    map.hideMarker('*')
                    map.showMarker(visibleMarkers)

                    if (visibleMarkers.length) {
                        map.fit()
                    }
                }))
            })
        })
    </script>
{% endblock %}
